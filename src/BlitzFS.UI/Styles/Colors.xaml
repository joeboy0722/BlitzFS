<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基礎背景色彩 (Slate Palette) -->
    <Color x:Key="ColorBackgroundDark">#0F172A</Color>
    <Color x:Key="ColorSurfaceDark">#1E293B</Color>
    <Color x:Key="ColorSurfaceLight">#334155</Color>
    <Color x:Key="ColorSurfaceHover">#475569</Color>
    <Color x:Key="ColorSurfaceSelected">#2563EB</Color>

    <!-- 前景文字色彩 -->
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <!-- 主題強調色 (Accents) -->
    <Color x:Key="ColorAccentSky">#38BDF8</Color>
    <Color x:Key="ColorAccentIndigo">#6366F1</Color>
    <Color x:Key="ColorAccentEmerald">#10B981</Color>
    <Color x:Key="ColorAccentAmber">#F59E0B</Color>
    <Color x:Key="ColorAccentRose">#F43F5E</Color>

    <!-- 邊框與分割線 -->
    <Color x:Key="ColorBorderSubtle">#334155</Color>
    <Color x:Key="ColorBorderStrong">#475569</Color>

    <!-- Brushes 筆刷定義 -->
    <SolidColorBrush x:Key="BrushBackgroundDark" Color="{StaticResource ColorBackgroundDark}" />
    <SolidColorBrush x:Key="BrushSurfaceDark" Color="{StaticResource ColorSurfaceDark}" />
    <SolidColorBrush x:Key="BrushSurfaceLight" Color="{StaticResource ColorSurfaceLight}" />
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="BrushSurfaceSelected" Color="{StaticResource ColorSurfaceSelected}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <SolidColorBrush x:Key="BrushAccentSky" Color="{StaticResource ColorAccentSky}" />
    <SolidColorBrush x:Key="BrushAccentIndigo" Color="{StaticResource ColorAccentIndigo}" />
    <SolidColorBrush x:Key="BrushAccentEmerald" Color="{StaticResource ColorAccentEmerald}" />
    <SolidColorBrush x:Key="BrushAccentAmber" Color="{StaticResource ColorAccentAmber}" />
    <SolidColorBrush x:Key="BrushAccentRose" Color="{StaticResource ColorAccentRose}" />

    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />

</ResourceDictionary>
