<Window x:Class="BlitzFS.UI.Views.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlitzFS 快速預覽 (Quick Look)" Height="560" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackgroundDark}"
        Foreground="{StaticResource BrushTextPrimary}"
        Closing="OnWindowClosing"
        KeyDown="OnWindowKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 頂部標題與中繼資料 -->
            <RowDefinition Height="*" />    <!-- 預覽主內容區 -->
            <RowDefinition Height="Auto" /> <!-- 底部提示 -->
        </Grid.RowDefinitions>

        <!-- 頂部資訊列 -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceDark}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtFileName" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtFilePath" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock x:Name="TxtFileSize" Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 主預覽區 (圖片 / 影片 / 文字代碼) -->
        <Border Grid.Row="1" Background="{StaticResource BrushSurfaceDark}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <Grid>
                <!-- 圖片預覽 -->
                <Image x:Name="ImgPreview" Visibility="Collapsed" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- 影片播放預覽 -->
                <MediaElement x:Name="VideoPreview" Visibility="Collapsed" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True" />

                <!-- 文字/代碼預覽 -->
                <ScrollViewer x:Name="ScrollText" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtPreviewContent" Background="Transparent" Foreground="{StaticResource BrushTextPrimary}"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                             IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部快捷鍵提示 -->
        <TextBlock Grid.Row="2" Text="按 [Space] 或 [Esc] 關閉預覽" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Right" />
    </Grid>
</Window>
