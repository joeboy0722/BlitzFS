<UserControl x:Class="BlitzFS.UI.Views.FilePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:BlitzFS.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="700"
             AllowDrop="True"
             DragOver="OnFilePaneDragOver"
             Drop="OnFilePaneDrop"
             PreviewMouseDown="OnFilePaneMouseDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 檔案/資料夾項目專用右鍵選單 -->
        <ContextMenu x:Key="ItemContextMenu">
            <MenuItem Header="開啟" Click="OnContextOpenClick" InputGestureText="Enter" FontWeight="SemiBold">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconFolder}" Fill="{StaticResource BrushAccentSky}" Width="12" Height="12" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="快速預覽" Click="OnContextQuickLookClick" InputGestureText="Space">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconQuickLook}" Fill="{StaticResource BrushAccentAmber}" Width="12" Height="12" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="{StaticResource BrushBorderSubtle}" Margin="0,2" />
            <MenuItem Header="複製" Click="OnContextCopyClick" InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCopy}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="剪下" Click="OnContextCutClick" InputGestureText="Ctrl+X">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconCut}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="重新命名" Click="OnContextRenameClick" InputGestureText="F2">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconRename}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="刪除" Click="OnContextDeleteClick" InputGestureText="Del">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconDelete}" Fill="{StaticResource BrushAccentRose}" Width="12" Height="12" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="{StaticResource BrushBorderSubtle}" Margin="0,2" />
            <MenuItem Header="複製完整路徑" Click="OnContextCopyFullPathClick" />
            <MenuItem Header="在 Windows 檔案總管中顯示" Click="OnContextShowInExplorerClick" />
        </ContextMenu>

        <!-- 空白處右鍵選單 -->
        <ContextMenu x:Key="BackgroundContextMenu">
            <MenuItem Header="新建資料夾" Click="OnContextNewFolderClick" InputGestureText="Ctrl+Shift+N">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconNewFolder}" Fill="{StaticResource BrushAccentEmerald}" Width="12" Height="12" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="貼上" Click="OnContextPasteClick" InputGestureText="Ctrl+V">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconPaste}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="{StaticResource BrushBorderSubtle}" Margin="0,2" />
            <MenuItem Header="重新整理" Click="OnRefreshClick" InputGestureText="F5">
                <MenuItem.Icon>
                    <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 導航與路徑列 -->
            <RowDefinition Height="*" />    <!-- 主檔案區 (清單 / 縮圖網格) -->
            <RowDefinition Height="Auto" /> <!-- 底部統計列 -->
        </Grid.RowDefinitions>

        <!-- 導航列與即打即篩框 -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceDark}" Padding="8,6" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- 導航按鈕 -->
                    <ColumnDefinition Width="*" />    <!-- 路徑顯示列 -->
                    <ColumnDefinition Width="150" />  <!-- 即打即篩框 -->
                </Grid.ColumnDefinitions>

                <!-- 上一頁 / 下一頁 / 上一層按鈕 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="6,4"
                            IsEnabled="{Binding CanGoBack}" Click="OnBackClick" ToolTip="上一頁 (Alt+Left 或滑鼠側鍵4)">
                        <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="6,4"
                            IsEnabled="{Binding CanGoForward}" Click="OnForwardClick" ToolTip="下一頁 (Alt+Right 或滑鼠側鍵5)">
                        <Path Data="{StaticResource IconArrowRight}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="6,4"
                            Click="OnUpClick" ToolTip="上一層 (Alt+Up 或 Backspace)">
                        <Path Data="{StaticResource IconArrowUp}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="6,4"
                            Click="OnRefreshClick" ToolTip="重新整理 (F5)">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!-- 路徑列 (可輸入與導航) -->
                <Border Grid.Column="1" Background="{StaticResource BrushBackgroundDark}" CornerRadius="6" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconFolder}" Fill="{StaticResource BrushAccentAmber}" Width="12" Height="12" Stretch="Uniform" Margin="8,0,4,0" VerticalAlignment="Center" />
                        <TextBox x:Name="PathTextBox" Grid.Column="1" Text="{Binding CurrentPath, Mode=OneWay}"
                                 Background="Transparent" Foreground="{StaticResource BrushAccentSky}" BorderThickness="0"
                                 FontWeight="Medium" FontSize="12" VerticalAlignment="Center" Padding="4,4"
                                 KeyDown="OnPathTextBoxKeyDown" />
                    </Grid>
                </Border>

                <!-- 0ms 即時模糊篩選框 -->
                <Grid Grid.Column="2">
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernSearchBoxStyle}"
                             Padding="24,4,6,4" />
                    <Path Data="{StaticResource IconSearch}" Fill="{StaticResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform"
                          HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <!-- 主檔案區 (支援背景右鍵選單) -->
        <Grid Grid.Row="1" ContextMenu="{StaticResource BackgroundContextMenu}">
            <!-- 模式一：詳細資訊清單 (Details View) -->
            <ListView x:Name="DetailsListView"
                      ItemsSource="{Binding FilteredItems}"
                      SelectedItem="{Binding SelectedItem}"
                      Style="{StaticResource VirtualListViewStyle}"
                      Visibility="{Binding IsDetailsView, Converter={StaticResource BoolToVis}}"
                      MouseDoubleClick="OnItemDoubleClick"
                      PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                      MouseMove="OnListMouseMove"
                      KeyDown="OnListViewKeyDown">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <!-- 檔名與圖示欄位 -->
                        <GridViewColumn Header="名稱" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 檔案大小欄位 -->
                        <GridViewColumn Header="大小" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedSize}" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Right" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- 修改日期欄位 -->
                        <GridViewColumn Header="修改日期" Width="145">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedDate}" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 模式二：縮圖網格檢視 (中縮圖 / 大縮圖相簿模式) -->
            <ListBox x:Name="ThumbnailListBox"
                     ItemsSource="{Binding FilteredItems}"
                     SelectedItem="{Binding SelectedItem}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding IsThumbnailView, Converter={StaticResource BoolToVis}}"
                     MouseDoubleClick="OnItemDoubleClick"
                     PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                     MouseMove="OnListMouseMove"
                     KeyDown="OnListViewKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemCard"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemCard" Property="Background" Value="{StaticResource BrushSurfaceHover}" />
                                            <Setter TargetName="ItemCard" Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemCard" Property="Background" Value="{StaticResource BrushSurfaceSelected}" />
                                            <Setter TargetName="ItemCard" Property="BorderBrush" Value="{StaticResource BrushAccentSky}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder" Background="{StaticResource BrushSurfaceDark}" CornerRadius="6"
                                Margin="0" Padding="8" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 縮圖大圖預覽區 (相片/影片首格縮圖) -->
                                <Border x:Name="ThumbImageBorder" Grid.Row="0" Width="110" Height="90" Background="{StaticResource BrushBackgroundDark}" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,6">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <!-- 檔名文字 -->
                                <TextBlock x:Name="ThumbFileName" Grid.Row="1" Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" Width="110" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="32" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.IsLargeIconsView}" Value="True">
                                <Setter TargetName="ThumbImageBorder" Property="Width" Value="180" />
                                <Setter TargetName="ThumbImageBorder" Property="Height" Value="150" />
                                <Setter TargetName="ThumbFileName" Property="Width" Value="180" />
                                <Setter TargetName="ThumbFileName" Property="FontSize" Value="12" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 底部狀態列 -->
        <Border Grid.Row="2" Background="{StaticResource BrushSurfaceDark}" Padding="8,4" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding FilteredItems.Count, StringFormat='共 {0} 個項目'}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
        </Border>
    </Grid>
</UserControl>
