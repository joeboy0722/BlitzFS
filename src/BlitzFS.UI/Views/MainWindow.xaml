<Window x:Class="BlitzFS.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BlitzFS.UI.Views"
        xmlns:vm="clr-namespace:BlitzFS.UI.ViewModels"
        Title="BlitzFS - 極速現代檔案總管" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackgroundDark}"
        Foreground="{StaticResource BrushTextPrimary}"
        Loaded="OnWindowLoaded"
        KeyDown="OnMainWindowKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 頂部一體化沉浸式標題與分頁列 (Custom Dark TitleBar & Tabs) -->
            <RowDefinition Height="Auto" /> <!-- 現代指令工具列 (Command Bar) -->
            <RowDefinition Height="*" />    <!-- 主工作區 (左側邊欄 + 主檔案區 + 右側預覽面板) -->
            <RowDefinition Height="Auto" /> <!-- 簡約底部狀態列 -->
        </Grid.RowDefinitions>

        <!-- 頂部一體化沉浸式標題與分頁列 (Custom Dark TitleBar & Tabs) -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurfaceDark}" Padding="12,0,0,0" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- App 品牌 Logo -->
                    <ColumnDefinition Width="*" />    <!-- 分頁標籤清單 -->
                    <ColumnDefinition Width="Auto" /> <!-- 視窗操作與自訂控制按鈕 -->
                </Grid.ColumnDefinitions>

                <!-- App 品牌標誌與名稱 (不可點擊，支援滑鼠雙擊最大化/拖曳視窗) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" IsHitTestVisible="False">
                    <Path Data="{StaticResource IconBolt}" Fill="{StaticResource BrushAccentSky}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                    <TextBlock Text="BlitzFS" Foreground="{StaticResource BrushTextPrimary}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 分頁標籤清單 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabCard" Margin="0,0,4,0" CornerRadius="8,8,0,0" Padding="12,6,8,6"
                                        Background="Transparent" BorderThickness="1,1,1,0" BorderBrush="Transparent"
                                        MouseLeftButtonDown="OnTabItemClick" Cursor="Hand">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- 頂部高亮焦點線 (僅選中時顯示) -->
                                        <Border x:Name="ActiveIndicator" Grid.Row="0" Height="2" Background="{StaticResource BrushAccentSky}"
                                                CornerRadius="1" Margin="-8,-6,-4,4" Visibility="Collapsed" />

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 資料夾圖示 -->
                                            <Path x:Name="TabIcon" Data="{StaticResource IconFolder}" Fill="{StaticResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <!-- 標題文字 -->
                                            <TextBlock x:Name="TxtTitle" Text="{Binding TabTitle}" Foreground="{StaticResource BrushTextMuted}" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <!-- 關閉分頁按鈕 (X) -->
                                            <Button Style="{StaticResource ToolbarButtonStyle}" Padding="2" Width="18" Height="18" Margin="0" Click="OnCloseTabClick" ToolTip="關閉分頁 (Ctrl+W)">
                                                <Path Data="{StaticResource IconClose}" Fill="{StaticResource BrushTextMuted}" Width="8" Height="8" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- 選中分頁狀態 (Active Tab) -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="TabCard" Property="Background" Value="{StaticResource BrushSurfaceDark}" />
                                        <Setter TargetName="TabCard" Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                                        <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TabIcon" Property="Fill" Value="{StaticResource BrushAccentAmber}" />
                                        <Setter TargetName="TxtTitle" Property="Foreground" Value="#FFFFFF" />
                                        <Setter TargetName="TxtTitle" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <!-- 未選中滑鼠懸停 (Hover) -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected}" Value="False" />
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="TabCard" Property="Background" Value="{StaticResource BrushSurfaceHover}" />
                                        <Setter TargetName="TxtTitle" Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 新增分頁按鈕 (+) -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="6,5" Margin="2,0,0,3" Click="OnAddTabClick" ToolTip="新增分頁 (Ctrl+T)">
                        <Path Data="{StaticResource IconPlus}" Fill="{StaticResource BrushTextPrimary}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!-- 右側視窗操作快捷與自訂視窗控制按鈕組 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center" Click="OnNewWindowClick" ToolTip="開啟新視窗 (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconNewWindow}" Fill="{StaticResource BrushTextPrimary}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="開新視窗" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 視窗控制三按鈕 (最小化 / 最大化 / 關閉) -->
                    <Button x:Name="BtnMinimize" Style="{StaticResource WindowControlButtonStyle}" Click="OnMinimizeClick" ToolTip="最小化">
                        <Path Data="{StaticResource IconWinMinimize}" Fill="{StaticResource BrushTextPrimary}" Width="10" Height="1" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource WindowControlButtonStyle}" Click="OnMaximizeClick" ToolTip="最大化 / 還原">
                        <Path x:Name="IconMaximizePath" Data="{StaticResource IconWinMaximize}" Fill="{StaticResource BrushTextPrimary}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButtonStyle}" Click="OnCloseClick" ToolTip="關閉">
                        <Path Data="{StaticResource IconWinClose}" Fill="{StaticResource BrushTextPrimary}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 現代指令工具列 (Command Bar) -->
        <Border Grid.Row="1" Background="{StaticResource BrushSurfaceDark}" Padding="8,4" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- 左側常用檔案操作 -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /> <!-- 右側檢視與排版切換 -->
                </Grid.ColumnDefinitions>

                <!-- 檔案常用操作 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnNewFolderClick" ToolTip="新建資料夾 (Ctrl+Shift+N)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconNewFolder}" Fill="{StaticResource BrushAccentEmerald}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="新建資料夾" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Separator Background="{StaticResource BrushBorderSubtle}" Margin="4,2" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnDeleteClick" ToolTip="刪除選取項目 (Del)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDelete}" Fill="{StaticResource BrushAccentRose}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="刪除" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Separator Background="{StaticResource BrushBorderSubtle}" Margin="4,2" />

                    <!-- 工具列排序下拉按鈕 (支援所有檢視模式) -->
                    <Button x:Name="BtnSortMenu" Style="{StaticResource ToolbarButtonStyle}" Click="OnSortButtonClick" ToolTip="排序方式">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSort}" Fill="{StaticResource BrushTextPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="排序" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Path Data="{StaticResource IconArrowDown}" Fill="{StaticResource BrushTextMuted}" Width="7" Height="7" Stretch="Uniform" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SortContextMenu">
                                <MenuItem x:Name="MenuSortName" Header="名稱" Click="OnSortByNameClick" />
                                <MenuItem x:Name="MenuSortDate" Header="修改日期" Click="OnSortByDateClick" />
                                <MenuItem x:Name="MenuSortSize" Header="大小" Click="OnSortBySizeClick" />
                                <MenuItem x:Name="MenuSortType" Header="類型" Click="OnSortByTypeClick" />
                                <Separator Background="{StaticResource BrushBorderSubtle}" Margin="0,2" />
                                <MenuItem x:Name="MenuSortAsc" Header="遞增 (由小到大 / A到Z)" Click="OnSortAscendingClick" />
                                <MenuItem x:Name="MenuSortDesc" Header="遞減 (由大到小 / Z到A)" Click="OnSortDescendingClick" />
                                <Separator Background="{StaticResource BrushBorderSubtle}" Margin="0,2" />
                                <MenuItem x:Name="MenuFoldersFirst" Header="資料夾優先置頂" Click="OnToggleFoldersFirstClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- 檢視切換與預覽面板開關 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 檢視模式：詳細資訊清單 -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnViewDetailsClick" ToolTip="詳細資訊清單">
                        <Path Data="{StaticResource IconViewDetails}" Fill="{StaticResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                    <!-- 檢視模式：中縮圖 -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnViewMediumIconsClick" ToolTip="中圖示網格">
                        <Path Data="{StaticResource IconViewGrid}" Fill="{StaticResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                    <!-- 檢視模式：大縮圖/相簿 -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnViewLargeIconsClick" ToolTip="大圖縮圖 (相簿模式)">
                        <Path Data="{StaticResource IconViewLarge}" Fill="{StaticResource BrushTextPrimary}" Width="13" Height="13" Stretch="Uniform" />
                    </Button>

                    <Separator Background="{StaticResource BrushBorderSubtle}" Margin="4,2" />

                    <!-- 雙窗格切換 (F10) -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnToggleDualPaneClick" ToolTip="切換雙窗格並排 (F10)">
                        <Path Data="{StaticResource IconDualPane}" Fill="{StaticResource BrushAccentSky}" Width="13" Height="13" Stretch="Uniform" />
                    </Button>

                    <!-- 右側預覽面板切換 -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnTogglePreviewPaneClick" ToolTip="開啟/收合即時預覽面板">
                        <Path Data="{StaticResource IconPreviewPane}" Fill="{StaticResource BrushAccentAmber}" Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主工作區 (左側邊欄 + 主檔案區 + 右側預覽面板) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- 左側邊欄 (Col 0) -->
                <ColumnDefinition Width="220" MinWidth="160" MaxWidth="350" />
                <!-- 側邊欄分割線 (Col 1) -->
                <ColumnDefinition Width="4" />
                <!-- 中央檔案工作區 (Col 2) -->
                <ColumnDefinition Width="*" />
                <!-- 預覽面板分割線欄位 (Col 3) -->
                <ColumnDefinition Width="Auto" />
                <!-- 右側預覽面板欄位 (Col 4) -->
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewPaneOpen}" Value="True">
                                    <Setter Property="Width" Value="340" />
                                    <Setter Property="MinWidth" Value="220" />
                                    <Setter Property="MaxWidth" Value="800" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!-- 左側導航側邊欄 -->
            <views:SidebarView Grid.Column="0" DataContext="{Binding Sidebar}" PathSelected="OnSidebarPathSelected" />

            <!-- 側邊欄拖曳分割線 -->
            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- 中央主檔案工作區 (單窗格或雙窗格) -->
            <Grid Grid.Column="2" Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDualPaneMode}" Value="True">
                                        <Setter Property="Width" Value="*" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!-- 左作用窗格 (Pane A) -->
                <Border Grid.Column="0" CornerRadius="6" BorderThickness="1.5" ClipToBounds="True"
                        PreviewMouseDown="OnPrimaryPaneFocused" GotFocus="OnPrimaryPaneFocused">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPrimaryActive}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentSky}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <views:FilePaneView x:Name="PrimaryPaneControl" DataContext="{Binding SelectedTab}" QuickLookRequested="OnQuickLookRequested" FileDropped="OnFileDropped" />
                </Border>

                <!-- 雙窗格分割線 (僅在雙窗格模式開啟時顯示) -->
                <GridSplitter Grid.Column="1" Width="6" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Visibility="{Binding IsDualPaneMode, Converter={StaticResource BoolToVis}}" />

                <!-- 副窗格 (Pane B - 雙窗格模式) -->
                <Border Grid.Column="2" CornerRadius="6" BorderThickness="1.5" ClipToBounds="True"
                        Visibility="{Binding IsDualPaneMode, Converter={StaticResource BoolToVis}}"
                        PreviewMouseDown="OnSecondaryPaneFocused" GotFocus="OnSecondaryPaneFocused">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSecondaryActive}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentSky}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <views:FilePaneView x:Name="SecondaryPaneControl" DataContext="{Binding SecondaryPane}" QuickLookRequested="OnQuickLookRequested" FileDropped="OnFileDropped" />
                </Border>
            </Grid>

            <!-- 預覽面板分割線 (GridSplitter 位於 Column 3) -->
            <GridSplitter Grid.Column="3" Width="4" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Visibility="{Binding IsPreviewPaneOpen, Converter={StaticResource BoolToVis}}" />

            <!-- 右側即時預覽面板 (Preview Pane - 寬度橫向自動填滿) -->
            <Border Grid.Column="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPreviewPaneOpen, Converter={StaticResource BoolToVis}}">
                <views:PreviewPaneView SelectedItem="{Binding PreviewItem}" />
            </Border>
        </Grid>

        <!-- 右下角現代浮動傳輸進度卡片 (Floating Toast) -->
        <Border Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Width="300"
                Background="{StaticResource BrushSurfaceDark}" CornerRadius="8" Padding="12"
                BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                Visibility="{Binding TransferHub.IsTransferring, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{Binding TransferHub.CurrentFileName, StringFormat='⚡ 正在極速傳輸: {0}'}" Foreground="{StaticResource BrushAccentSky}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ProgressBar Height="6" Maximum="100" Value="{Binding TransferHub.ProgressPercentage}" Background="{StaticResource BrushBackgroundDark}" Foreground="{StaticResource BrushAccentEmerald}" BorderThickness="0" Margin="0,4" />
                <TextBlock Text="{Binding TransferHub.StatusSummary}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- 底部簡約狀態列 -->
        <StatusBar Grid.Row="3" Background="{StaticResource BrushSurfaceDark}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" Padding="8,3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="⚡ BlitzFS C++20 Zero-Copy | [Ctrl+T] 新分頁 | [Ctrl+N] 新視窗 | [Space] 快速預覽 | [F10] 雙窗格" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
